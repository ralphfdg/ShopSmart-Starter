DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
# production makes the sign-in cookie HTTPS-only and blocks the destructive db:seed.
NODE_ENV=development
# Hosted deployments only: listen address. Use 127.0.0.1 so only the web server on the same machine can reach the API.
HOST=
# Hosted deployments only: number of proxies in front of the API (usually 1). Leave empty locally.
TRUST_PROXY=
# Server-only. Get a free key from Google AI Studio. Without a key the assistant uses its rule-based answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Fictional test customers for npm run db:seed:customers (at least 12 characters each). Never commit real values.
TEST_CUSTOMER_ONE_PASSWORD=
TEST_CUSTOMER_TWO_PASSWORD=
