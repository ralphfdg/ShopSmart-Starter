# Copy to /etc/shopsmart/api.env on the server (sudo chmod 600). Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# The exact HTTPS address of the shop (same hostname as in the Caddyfile).
FRONTEND_URL=https://shop.example.com
# Caddy is one proxy in front of the API.
TRUST_PROXY=1
# Secret. A dedicated database user with a long random password.
DATABASE_URL=postgresql://shopsmart_app:CHANGE_ME@localhost:5432/shopsmart?schema=public
# Secret and optional. Leave empty to use the labelled catalog answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Fictional test customers for npm run db:seed:customers (at least 12 characters each).
TEST_CUSTOMER_ONE_PASSWORD=
TEST_CUSTOMER_TWO_PASSWORD=
