# systemd service: starts the ShopSmart API at boot and restarts it if it crashes.
# Install: sudo cp deploy/shopsmart-api.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now shopsmart-api
# Logs:    sudo journalctl -u shopsmart-api -f

[Unit]
Description=ShopSmart Express API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=shopsmart
WorkingDirectory=/opt/shopsmart/backend
# Server-only settings (DATABASE_URL, GEMINI_API_KEY). Owned by root, mode 600. Never committed.
EnvironmentFile=/etc/shopsmart/api.env
ExecStart=/usr/local/bin/node src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
